{
  "name": "jr-electricidad",
  "version": "3.0.0",
  "description": "Plataforma web y de gestión para JR Electricidad | Electricista Matriculado Cat. 3 — V3",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prod": "node server.js",
    "test": "node scripts/check-project.js",
    "test:v2": "node scripts/check-project.js && node scripts/check-v2-foundation.js",
    "migrate": "node scripts/run-migrations.js",
    "test:v2-security": "node scripts/check-v2-security.js",
    "test:v2-accounts": "node scripts/check-v2-accounts.js",
    "test:v2-clients": "node scripts/check-v2-clients.js",
    "test:v2-requests": "node scripts/check-v2-requests.js",
    "test:v2-quotes": "node scripts/check-v2-quotes.js",
    "test:v2-acceptance": "node scripts/check-v2-acceptance.js",
    "test:v2-jobs": "node scripts/check-v2-jobs.js",
    "test:v2-gallery": "node scripts/check-v2-gallery.js",
    "test:v2-dashboard": "node scripts/check-v2-dashboard.js",
    "test:v2-notifications": "node scripts/check-v2-notifications.js",
    "test:v2-email": "node scripts/check-v2-email.js",
    "test:v2-whatsapp": "node scripts/check-v2-whatsapp.js",
    "test:v2-documents": "node scripts/check-v2-documents.js",
    "test:v2-search": "node scripts/check-v2-search.js",
    "test:v2-configuration": "node scripts/check-v2-configuration.js",
    "test:v2-audit": "node scripts/check-v2-audit.js",
    "backup:v2": "node scripts/backup-database.js",
    "test:v2-backups": "node scripts/check-v2-backups.js",
    "test:v2-production": "node scripts/check-v2-production.js",
    "test:v2-responsive": "node scripts/check-v2-responsive.js",
    "test:v2-unit": "node --test scripts/test-v2-unit.js",
    "test:v2-all": "node scripts/test-v2-all.js",
    "migration:v1-v2": "node scripts/migrate-v1-to-v2.js --yes",
    "migration:v1-v2:dry-run": "node scripts/migrate-v1-to-v2.js --dry-run",
    "test:v2-migration": "node scripts/check-v2-migration.js",
    "test:v3-foundation": "node scripts/check-v3-foundation.js",
    "test:v3-public": "node scripts/check-v3-public.js",
    "test:v3-client": "node scripts/check-v3-client.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "mysql2": "^3.24.4",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  },
  "overrides": {}
}
